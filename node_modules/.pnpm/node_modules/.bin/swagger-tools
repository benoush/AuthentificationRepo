#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/darknoush/APIarticle/node_modules/.pnpm/swagger-tools@0.9.16/node_modules/swagger-tools/node_modules:/home/darknoush/APIarticle/node_modules/.pnpm/swagger-tools@0.9.16/node_modules:/home/darknoush/APIarticle/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/darknoush/APIarticle/node_modules/.pnpm/swagger-tools@0.9.16/node_modules/swagger-tools/node_modules:/home/darknoush/APIarticle/node_modules/.pnpm/swagger-tools@0.9.16/node_modules:/home/darknoush/APIarticle/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../swagger-tools/bin/swagger-tools" "$@"
else
  exec node  "$basedir/../swagger-tools/bin/swagger-tools" "$@"
fi
